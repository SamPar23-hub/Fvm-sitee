{
  "name": "Story Vlog",
  "cut": {
    "max_pause": 0.3,
    "pad_in": 0.05,
    "pad_out": 0.12,
    "drop_fillers": true
  },
  "video": {
    "punch_in": [
      1.0
    ],
    "crop_y": 0.4,
    "fps": 30
  },
  "grade": {
    "ffmpeg": "eq=brightness=-0.07:contrast=1.14:saturation=0.86,colorbalance=bs=0.07:bm=0.02:rh=-0.03:rm=-0.01,curves=master='0/0.02 0.25/0.17 0.5/0.42 0.85/0.76 1/0.88',vignette=PI/5"
  },
  "audio": {
    "chain": "highpass=f=80,afftdn=nf=-25,acompressor=threshold=-20dB:ratio=3:attack=5:release=80:makeup=2,alimiter=limit=0.89",
    "lufs": -14
  },
  "captions": {
    "mode": "single",
    "uppercase": true,
    "style": {
      "color": "#FFFFFF",
      "shadow": 3,
      "shadow_alpha": 96,
      "outline": 0,
      "align": 5,
      "font": "Barlow SemiBold",
      "italic": true,
      "size": 80,
      "y": 0.7,
      "spacing": 1
    },
    "title_secs": 4.5,
    "title_style": {
      "color": "#FFFFFF",
      "shadow": 3,
      "shadow_alpha": 96,
      "outline": 0,
      "align": 5,
      "font": "Barlow Condensed SemiBold",
      "size": 70,
      "y": 0.2,
      "spacing": 1
    },
    "watermark": {
      "handle": "@SHOTBYFVM",
      "x": 0.86,
      "y": 0.29,
      "icon": 40,
      "size": 24
    }
  }
}
