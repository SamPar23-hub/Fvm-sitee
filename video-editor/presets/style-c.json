{
  "name": "Cinematic Voiceover",
  "cut": {
    "max_pause": 0.3,
    "pad_in": 0.05,
    "pad_out": 0.12,
    "drop_fillers": true
  },
  "video": {
    "punch_in": [
      1.0
    ],
    "crop_y": 0.5,
    "fps": 30
  },
  "grade": {
    "ffmpeg": "eq=brightness=-0.025:contrast=1.06:saturation=1.05,curves=master='0/0 0.5/0.48 0.85/0.80 1/0.93'"
  },
  "audio": {
    "chain": "highpass=f=80,afftdn=nf=-25,acompressor=threshold=-20dB:ratio=3:attack=5:release=80:makeup=2,alimiter=limit=0.89",
    "lufs": -14
  },
  "captions": {
    "mode": "build",
    "min_words": 4,
    "max_words": 8,
    "wrap": 20,
    "style": {
      "color": "#FFFFFF",
      "shadow": 2,
      "shadow_alpha": 96,
      "outline": 0,
      "align": 5,
      "font": "Poppins",
      "bold": true,
      "size": 72,
      "y": 0.62
    }
  }
}
