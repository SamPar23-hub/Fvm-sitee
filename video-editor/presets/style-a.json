{
  "name": "Talking Head + Cards",
  "cut": {
    "max_pause": 0.35,
    "pad_in": 0.06,
    "pad_out": 0.14,
    "drop_fillers": true
  },
  "video": {
    "punch_in": [
      1.0
    ],
    "crop_y": 0.35,
    "fps": 30
  },
  "grade": {
    "ffmpeg": "eq=brightness=-0.025:contrast=1.06:saturation=1.05,curves=master='0/0 0.5/0.48 0.85/0.80 1/0.93'"
  },
  "audio": {
    "chain": "highpass=f=80,afftdn=nf=-25,acompressor=threshold=-20dB:ratio=3:attack=5:release=80:makeup=2,alimiter=limit=0.89",
    "lufs": -14
  },
  "captions": {
    "mode": "chunk",
    "min_words": 2,
    "max_words": 3,
    "pop": true,
    "fade": false,
    "style": {
      "color": "#FFFFFF",
      "shadow": 3,
      "shadow_alpha": 96,
      "outline": 0,
      "align": 5,
      "font": "Poppins",
      "bold": true,
      "size": 72,
      "y": 0.58
    },
    "title_secs": 15,
    "title_style": {
      "color": "#FFFFFF",
      "shadow": 2,
      "shadow_alpha": 96,
      "outline": 0,
      "align": 5,
      "font": "DM Serif Display",
      "size": 80,
      "y": 0.47
    }
  }
}
